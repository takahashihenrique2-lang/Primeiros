print("Você irá criar um personagem para o seu RPG. Vamos começar!")
print("Qual é o nome do seu personagem?")
nome_digitado = input("Digite o nome do seu personagem: ")
print("Qual é a classe do seu personagem? (Guerreiro, Mago, Arqueiro). Digite 1 para Guerreiro, 2 para Mago, 3 para Arqueiro.")
classe_digitada = input("Digite o número correspondente à classe do seu personagem: ")
if classe_digitada == "1":
    classe_digitada = "Guerreiro"
elif classe_digitada == "2":    
    classe_digitada = "Mago"
elif classe_digitada == "3":
    classe_digitada = "Arqueiro"
else:
    print("Opção inválida. O personagem será criado como Guerreiro por padrão.")
    classe = "Guerreiro"

class Personagem:
    def __init__(self, nome, classe):
        self.nome = nome
        self.classe = classe
    def mostrar_informacoes(self):
        print(f"Nome: {self.nome}")
        print(f"Classe: {self.classe}")

        if self.classe == "Guerreiro":
            self.vida = 120
            self.força = 15
            self.inteligencia = 5
            self.agilidade = 8
        elif self.classe == "Mago":
            self.vida = 80
            self.força = 5
            self.inteligencia = 18
            self.agilidade = 7
        elif self.classe == "Arqueiro":
            self.vida = 100
            self.força = 10
            self.inteligencia = 8
            self.agilidade = 15

    def mostrar_atributos(self):
        print(f"Vida: {self.vida}")
        print(f"Força: {self.força}")
        print(f"Inteligência: {self.inteligencia}")
        print(f"Agilidade: {self.agilidade}")

meu_personagem = Personagem(nome_digitado, classe_digitada)
meu_personagem.mostrar_informacoes()
meu_personagem.mostrar_atributos()



